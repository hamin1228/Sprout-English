# ── DB 설정 ──────────────────────────────────
DB_USER=ea
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1        # 로컬 직접 실행 시
# DB_HOST=mysql          # Docker Compose 실행 시 이 줄로 교체
DB_PORT=3306
DB_NAME=english_ai

# ── OpenAI API ────────────────────────────────
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# ── MySQL root (docker-compose 전용) ──────────
MYSQL_ROOT_PASSWORD=your_root_password
