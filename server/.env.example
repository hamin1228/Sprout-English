# =============================================================================
# Sprout English — FastAPI 서버 환경변수 예시
# 이 파일을 복사해서 server/.env 로 만든 뒤 실제 값을 입력하세요.
# 실제 키/비밀번호는 절대 이 파일에 직접 입력하지 마세요.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
DB_USER=ea
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1          # 로컬 직접 실행 시
# DB_HOST=mysql            # Docker Compose 실행 시 이 줄로 교체
DB_PORT=3306
DB_NAME=english_ai

# ── OpenAI API ────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# 사용 모델 (기본값은 변경하지 않아도 됨)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=            # 빈 값 = Whisper API 기본 모델
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova            # alloy | echo | fable | onyx | nova | shimmer
OPENAI_TTS_SPEED=1.0             # 0.25 ~ 4.0

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://redis:6379/0  # Docker Compose 실행 시 이 줄로 교체

# ── Storage ───────────────────────────────────────────────────────────────────
# 음성 파일 저장 경로 (컨테이너 내부 경로, 볼륨 마운트와 일치해야 함)
STORAGE_LOCAL_PATH=./app/storage

# ── CORS ──────────────────────────────────────────────────────────────────────
# 개발 환경: * (모든 Origin 허용 — 운영 환경에서는 반드시 명시적으로 지정할 것)
# 운영 환경 예: CORS_ORIGINS=https://your-domain.com,https://api.your-domain.com
CORS_ORIGINS=*

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development         # development | production
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

# ── MySQL root (docker-compose 전용) ──────────────────────────────────────────
MYSQL_ROOT_PASSWORD=your_root_password
