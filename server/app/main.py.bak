# app/main.py
from __future__ import annotations
from fastapi import FastAPI, UploadFile, File
from pydantic import BaseModel, Field
from pathlib import Path
from typing import Any, Dict
import json

try:
    import yaml  # type: ignore
except Exception:
    yaml = None  # PyYAML is optional

app = FastAPI()

# ----------------- Config Loading Helpers -----------------
CONFIG_DIR = Path(__file__).resolve().parents[1] / "config"

def _read_text(rel: str) -> str | None:
    p = CONFIG_DIR / rel
    try:
        return p.read_text(encoding="utf-8")
    except FileNotFoundError:
        return None

def read_prompts() -> Dict[str, Any]:
    text = _read_text("prompts/base.md")
    if text is None:
        text = (
            "# System Prompt — English AI Tutor (Baseline)\n"
            "(default stub; create server/config/prompts/base.md to override)\n"
        )
    return {"base": text}

def read_tone_rules() -> Dict[str, Any]:
    try:
        with (CONFIG_DIR / "tone_rules.json").open("r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {
            "_warning": "tone_rules.json not found; using minimal defaults",
            "A1": {"avg_sentence_tokens": 8, "sentence_max_tokens": 12, "target_wpm": 90},
            "B2": {"avg_sentence_tokens": 16, "sentence_max_tokens": 22, "target_wpm": 130},
        }

def read_modes() -> Dict[str, Any]:
    text = _read_text("modes.yaml")
    if text is None:
        return {
            "_warning": "modes.yaml not found; using minimal defaults",
            "FreeTalk": {"goal": "Open conversation", "evaluation": "Speaking rubric v0"},
            "Writing": {"goal": "Short writing task", "evaluation": "Writing rubric v0"},
        }
    if yaml is None:
        return {"raw": text, "_warning": "PyYAML not installed; returning raw YAML string."}
    try:
        return yaml.safe_load(text) or {}
    except Exception as e:
        return {"raw": text, "_warning": f"YAML parse error: {e}"}

# ----------------- Evaluators (Rubrics v0) -----------------

def clamp01(x: float) -> float:
    return max(0.0, min(1.0, x))

def score_to_cefr(s: float) -> str:
    if s < 0.25:
        return "A1"
    elif s < 0.40:
        return "A2"
    elif s < 0.55:
        return "B1"
    elif s < 0.70:
        return "B2"
    elif s < 0.85:
        return "C1"
    return "C2"

class SpeakingMetrics(BaseModel):
    wpm: float = Field(..., ge=0, description="Words per minute")
    silence_ratio: float = Field(..., ge=0, le=1, description="0~1")
    filler_per_min: float = Field(..., ge=0, description="uh/um per minute")
    grammar_error_rate: float = Field(..., ge=0, description="errors per 100 tokens")
    cohesion: float = Field(..., ge=0, le=1, description="0~1")

def score_speaking(m: SpeakingMetrics) -> Dict[str, Any]:
    wpm_score = clamp01((m.wpm - 70.0) / 70.0)
    silence_score = 1.0 - clamp01(m.silence_ratio / 0.35)
    filler_score = 1.0 - clamp01(m.filler_per_min / 8.0)
    grammar_score = 1.0 - clamp01(m.grammar_error_rate / 12.0)
    cohesion_score = clamp01(m.cohesion)

    weights = dict(wpm=0.2, silence=0.2, filler=0.2, grammar=0.2, cohesion=0.2)
    total = (
        wpm_score * weights["wpm"]
        + silence_score * weights["silence"]
        + filler_score * weights["filler"]
        + grammar_score * weights["grammar"]
        + cohesion_score * weights["cohesion"]
    )
    return {
        "subscores": {
            "wpm_score": round(wpm_score, 3),
            "silence_score": round(silence_score, 3),
            "filler_score": round(filler_score, 3),
            "grammar_score": round(grammar_score, 3),
            "cohesion_score": round(cohesion_score, 3),
        },
        "total": round(total, 3),
        "cefr": score_to_cefr(total),
    }

class WritingMetrics(BaseModel):
    grammar_error_rate: float = Field(..., ge=0, description="errors per 100 words")
    lexical_richness: float = Field(..., ge=0, le=1, description="0~1")
    cohesion: float = Field(..., ge=0, le=1, description="0~1")
    variety: float = Field(..., ge=0, le=1, description="0~1")
    task: float = Field(..., ge=0, le=1, description="0~1 task fulfillment")

def score_writing(m: WritingMetrics) -> Dict[str, Any]:
    grammar_score = 1.0 - clamp01(m.grammar_error_rate / 10.0)
    lexical = clamp01(m.lexical_richness)
    cohesion = clamp01(m.cohesion)
    variety = clamp01(m.variety)
    task = clamp01(m.task)

    weights = dict(grammar=0.35, lexical=0.20, cohesion=0.20, variety=0.10, task=0.15)
    total = (
        grammar_score * weights["grammar"]
        + lexical * weights["lexical"]
        + cohesion * weights["cohesion"]
        + variety * weights["variety"]
        + task * weights["task"]
    )
    return {
        "subscores": {
            "grammar_score": round(grammar_score, 3),
            "lexical": round(lexical, 3),
            "cohesion": round(cohesion, 3),
            "variety": round(variety, 3),
            "task": round(task, 3),
        },
        "total": round(total, 3),
        "cefr": score_to_cefr(total),
    }

# ----------------- Startup Hook -----------------
@app.on_event("startup")
async def on_startup() -> None:
    # Optional DB init if available
    try:
        from app.db import init_db  # type: ignore
        await init_db()
    except Exception as e:
        print(f"[WARN] init_db skipped or failed: {e}")

# ----------------- Health -----------------
@app.get("/healthz")
def health():
    return {"ok": True}

# ----------------- Speech Turn -----------------
@app.post("/speech/turn")
async def speech_turn(file: UploadFile = File(...)):
    # 업로드된 파일을 메모리로 읽음(바이트)
    audio_bytes = await file.read()

    # TODO: 여기서 STT(음성→텍스트) 호출을 붙일 예정
    # 예: transcript = await stt(audio_bytes)

    return {
        "filename": file.filename,
        "size_bytes": len(audio_bytes),
        "transcript": "demo transcript",  # 임시 고정값
        "duration_ms": 0,                  # 임시 고정값
    }

# ----------------- Config Endpoints -----------------
@app.get("/config/prompts")
async def get_prompts():
    return read_prompts()

@app.get("/config/tones")
async def get_tones():
    return read_tone_rules()

@app.get("/config/modes")
async def get_modes():
    return read_modes()

# ----------------- Eval Endpoints -----------------
@app.post("/eval/speaking")
async def eval_speaking(payload: SpeakingMetrics):
    return score_speaking(payload)

@app.post("/eval/writing")
async def eval_writing(payload: WritingMetrics):
    return score_writing(payload)
